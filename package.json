{
  "name": "bari-cns-workspace",
  "productName": "BARI-CNS Research Workspace",
  "version": "0.3.0",
  "description": "Offline research workspace for exploring BARI-CNS study spreadsheets with preserved provenance and QC context.",
  "private": true,
  "license": "UNLICENSED",
  "author": "BARI-CNS Lab",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:reference": "vitest run --config vitest.reference.config.ts",
    "fixtures": "python3 -I tools/make_fixtures.py tests/fixtures",
    "e2e": "npm run build && playwright test",
    "e2e:packaged": "BARI_E2E_PACKAGED=1 playwright test",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "echarts": "6.1.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "build": {
    "appId": "org.barilab.cns-workspace",
    "productName": "BARI-CNS Research Workspace",
    "copyright": "BARI-CNS Lab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tests/fixtures/demo_workbook.xlsx",
        "to": "demo/demo_workbook.xlsx"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.medical",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "BARI-CNS Research Workspace"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BARI-CNS-Research-Workspace-Setup-${version}.${ext}"
    }
  }
}
