{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"], "@shared/*": ["src/shared/*"], "@importer/*": ["src/importer/*"] }
  },
  "include": ["src", "tests", "e2e", "electron.vite.config.ts", "vitest.config.ts", "vitest.reference.config.ts", "playwright.config.ts"]
}
